# Copy this file to .env.local and fill in your key.
# The key is read server-side only; it is never sent to the browser.
# Without this key the app works normally in demo mode.
# Get a key at: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=

# ── Supabase ────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Get these from: Supabase Dashboard > Project > Settings > API

# Project URL (safe to expose to the browser)
VITE_SUPABASE_URL=

# Anonymous / publishable key (safe to expose to the browser)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Service-role / secret key — SERVER SIDE ONLY.
# NEVER import this into src/ or commit the real value.
# Used only for local CRUD verification (scripts/test-db.ts).
SUPABASE_SERVICE_ROLE_KEY=
